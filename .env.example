# ---------------------------------------------------------------------------
# REQUIRED: only the LLM provider and its key.
# Every other setting has a calibrated default in app/core/config.py
# (measured on Samsung's real data -- see TESTING.md). Add a line below only
# to deliberately override a default.
# ---------------------------------------------------------------------------

# NVIDIA API (OpenAI-compatible). LLM_PROVIDER stays "openrouter": that is
# the name of our OpenAI-compatible client, not the host.
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b

# Alternative: Gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here
# LLM_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# OPTIONAL overrides (defaults shown; leave commented unless experimenting)
# ---------------------------------------------------------------------------
# CACHE_HIT_THRESHOLD=0.75   # 0.85 = each similar query gets its own plan; fewer cache hits
# DEEPLINK_ALPHA=0.75
# DEEPLINK_MIN_CONFIDENCE=0.6
# DEEPLINK_MARGIN=0.08
# RETRIEVAL_TEXT_VERSION=v1
# SIIS_RELEVANCE_MIN_SIMILARITY=0.32
# UNMATCHED_AUTO_POLICY=hybrid
# GROUNDING_MIN_ACTION_SUPPORT=0.5
# REPAIR_TIME_BUDGET_MS=6000
# SCORE_MODE=evidence
# LLM_DISABLE_THINKING=true
# LLM_JSON_MODE=true
# CACHE_WARM_PATH=app/data/cache_warm.jsonl
# LLM_PRICE_PER_MTOK_INPUT=0     # USD per 1M prompt tokens (0 = free tier)
# LLM_PRICE_PER_MTOK_OUTPUT=0    # USD per 1M completion tokens
# ENABLE_DIAGNOSTICS=false   # true enables /v1/provider-check (live LLM call) for local debugging
